# LangSmith Personal Access Token (required)
# Get this from: https://smith.langchain.com/settings
LANGSMITH_API_KEY=your-langsmith-pat-here

# Fleet deployment URL (required)
# Find this in Fleet > Settings > View code snippets
AGENT_API_URL=https://your-fleet-deployment.us.langgraph.app

# Agent ID (required)
# Find this in Fleet > Settings > View code snippets
AGENT_ID=your-agent-uuid-here

# GitHub webhook secret (required)
# Set this when creating the webhook in your GitHub repo settings
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# Server port (optional, defaults to 8000)
# PORT=8000
